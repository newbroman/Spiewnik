# Copy to .env for local use, or set these in the Vercel project settings.

# Your Musixmatch API key (from developer.musixmatch.com).
# Used server-side by api/musixmatch.js — never exposed to the browser.
MUSIXMATCH_API_KEY=

# Optional, local dev only: point `npm run dev` at your deployed functions so
# /api works without running Vercel locally, e.g. https://spiewnik.vercel.app
VITE_PROXY_TARGET=

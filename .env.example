# Copy to .env for local use (`vercel dev`), or set these in the Vercel
# project's Settings -> Environment Variables. Everything except the VITE_*
# values is read ONLY by the serverless functions in api/ and never reaches
# the browser.

# --- Supabase (accounts + database) ------------------------------------------
# Client, read at build time. The publishable/anon key is safe in the browser;
# Row Level Security protects each person's data. Defaults are baked into
# src/supabase.js, so these are only needed to point at a different project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server side (api/_auth.js, api/_supa.js). Used to verify users' JWTs (via the
# project's JWKS) and to call the usage / key RPCs AS the signed-in user.
# No service-role key is needed. Optional: defaults match the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- OpenAI (api/ai.js) ------------------------------------------------------
# Voice transcription, song suggestions, emoji anchors, lyric tidy, lyric
# extraction from a link, web lyric finder, word gloss. Capped per user per
# month (AI_LIMIT in api/_aicap.js).
OPENAI_API_KEY=

# --- Translation (api/translate.js) ------------------------------------------
# Default provider: "deepl" (default) or "google".
TRANSLATE_PROVIDER=deepl
# Shared DeepL key (deepl.com/pro-api). Free keys end in ":fx". Each user gets
# TRIAL_CHARS free characters a month on it, then adds their own key.
DEEPL_API_KEY=
# Optional Google Cloud Translation key. Used for provider "google", and as an
# automatic fallback when the shared DeepL key is out of quota (HTTP 456).
GOOGLE_TRANSLATE_API_KEY=

# --- Players and song search -------------------------------------------------
# YouTube Data API v3 key (console.cloud.google.com, no card). api/youtube.js
# and YouTube links in api/resolve.js.
YOUTUBE_API_KEY=
# Spotify app-only (Client Credentials) keys from developer.spotify.com.
# Used by api/search.js (catalogue search), api/resolve.js (pasted Spotify
# links) and api/spotify.js (legacy embed lookup).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Legacy single-user lock (optional) --------------------------------------
# When set, a request carrying this passphrase (x-spiewnik-pass header) is
# allowed without signing in and is NOT quota-limited. Leave blank for the
# normal multi-user app.
APP_PASSPHRASE=

# --- Local development only --------------------------------------------------
# Point `npm run dev` at your deployed functions so /api works without running
# Vercel locally, e.g. https://spiewnik.vercel.app
VITE_PROXY_TARGET=
